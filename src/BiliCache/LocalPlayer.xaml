<UserControl x:Class="BiliCache.LocalPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="True">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Background" Value="#283951"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Background="#101827" Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="18,12"><TextBlock x:Name="NowPlaying" Text="本地播放器" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MediaInfo" Text="从缓存列表选择视频，或打开本地文件。播放无需联网。" Foreground="#A4B1C8" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
  <Grid Grid.Row="1" Background="Black" MinHeight="200" MouseLeftButtonDown="Video_Click">
   <Image x:Name="VideoSurface" Stretch="Uniform"/>
   <TextBlock x:Name="EmptyHint" Text="选择一个本地视频开始播放" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="20"/>
  </Grid>
  <Grid Grid.Row="2" Margin="16,13,16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PositionLabel" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" ValueChanged="Timeline_Changed" Thumb.DragStarted="Timeline_DragStarted" Thumb.DragCompleted="Timeline_DragCompleted" VerticalAlignment="Center"/>
   <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="00:00" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
  </Grid>
  <DockPanel Grid.Row="3" Margin="16,0,16,15" LastChildFill="False">
   <Button Content="打开本地视频" DockPanel.Dock="Right" Click="OpenFile_Click" Margin="10,0,0,0"/>
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
    <Button x:Name="ToggleButton" Content="播放" Click="Toggle_Click" IsEnabled="False"/>
    <Button Content="−10 秒" Click="Back_Click"/><Button Content="+10 秒" Click="Forward_Click"/>
    <Button Content="停止" Click="Stop_Click"/>
    <TextBlock Text="音量" Foreground="#A4B1C8" VerticalAlignment="Center" Margin="8,0"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.6" Width="85" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
    <ComboBox x:Name="SpeedBox" SelectedIndex="1" Width="85" Margin="14,0,0,0" SelectionChanged="Speed_Changed"><ComboBoxItem Content="0.5×" Tag="0.5"/><ComboBoxItem Content="1.0×" Tag="1"/><ComboBoxItem Content="1.25×" Tag="1.25"/><ComboBoxItem Content="1.5×" Tag="1.5"/><ComboBoxItem Content="2.0×" Tag="2"/></ComboBox>
   </StackPanel>
  </DockPanel>
 </Grid>
</UserControl>
