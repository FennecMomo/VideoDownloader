<UserControl x:Class="BiliCache.LocalPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PlayerAccent" Color="#3975EB"/>
        <SolidColorBrush x:Key="PlayerText" Color="#244775"/>
        <SolidColorBrush x:Key="PlayerButtonBackground" Color="#EAF0FA"/>
        <StreamGeometry x:Key="PlayIcon">M 5,2 L 19,10 5,18 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIcon">M 4,2 H 8 V 18 H 4 Z M 12,2 H 16 V 18 H 12 Z</StreamGeometry>
        <StreamGeometry x:Key="StopIcon">M 3,3 H 17 V 17 H 3 Z</StreamGeometry>
        <StreamGeometry x:Key="BackIcon">M 10,3 L 1,10 10,17 Z M 19,3 L 10,10 19,17 Z</StreamGeometry>
        <StreamGeometry x:Key="ForwardIcon">M 1,3 L 10,10 1,17 Z M 10,3 L 19,10 10,17 Z</StreamGeometry>
        <StreamGeometry x:Key="SubtitleIcon">F0 M 2,3 H 22 V 17 H 2 Z M 4,5 H 20 V 15 H 4 Z M 6,9 H 11 V 11 H 6 Z M 13,9 H 18 V 11 H 13 Z M 6,12 H 18 V 13 H 6 Z</StreamGeometry>

        <Style x:Key="PlayerButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="{StaticResource PlayerButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource PlayerText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PlayerText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Path Data="{Binding}" Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Background" Value="{StaticResource PlayerAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Content" Value="{StaticResource PlayIcon}"/>
            <Setter Property="ToolTip" Value="播放"/>
            <Setter Property="AutomationProperties.Name" Value="播放"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Content" Value="{StaticResource PauseIcon}"/>
                    <Setter Property="ToolTip" Value="暂停"/>
                    <Setter Property="AutomationProperties.Name" Value="暂停"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="Surface" Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="{StaticResource PlayerAccent}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource PlayerAccent}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="#D8E3F4"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="NowPlaying" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MediaInfo" Foreground="#59718D" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PlayerButton}" Click="OpenFile_Click"
                        AutomationProperties.Name="打开本地视频">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 1,3 H 8 L 10,5 H 19 V 16 H 1 Z" Fill="{StaticResource PlayerText}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="打开本地视频" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" MinHeight="200" SizeChanged="VideoViewport_SizeChanged" MouseLeftButtonDown="Video_Click">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="#F4F6FA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=VideoSurface}" Value="Visible">
                                <Setter Property="Background" Value="Black"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Image x:Name="VideoSurface" Stretch="Uniform" Visibility="Collapsed"/>
                <Border x:Name="SubtitleOverlay" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="24,0,24,20" Padding="12,6" CornerRadius="6" Background="#D9101827"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="SubtitleText" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <StackPanel x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <Border Width="48" Height="48" Background="{StaticResource PlayerButtonBackground}" CornerRadius="12">
                        <Path Data="{StaticResource PlayIcon}" Fill="{StaticResource PlayerAccent}" Width="16" Height="16"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="EmptyHint" Text="选择一个本地视频开始播放" Foreground="{StaticResource PlayerText}"
                               FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionLabel" Text="00:00" Foreground="{StaticResource PlayerText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="Timeline" Grid.Column="1" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1"
                        IsEnabled="False" IsMoveToPointEnabled="True" AutomationProperties.Name="播放进度"
                        ValueChanged="Timeline_Changed" Thumb.DragStarted="Timeline_DragStarted" Thumb.DragCompleted="Timeline_DragCompleted"/>
                <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="00:00" Foreground="{StaticResource PlayerText}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>

            <DockPanel Grid.Row="3" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource TransportButton}" Content="{StaticResource BackIcon}"
                            IsEnabled="{Binding IsEnabled, ElementName=ToggleButton}" ToolTip="后退 10 秒"
                            AutomationProperties.Name="后退 10 秒" Click="Back_Click"/>
                    <Button x:Name="ToggleButton" Style="{StaticResource PlayPauseButton}" IsEnabled="False" Click="Toggle_Click"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource TransportButton}" Content="{StaticResource ForwardIcon}"
                            IsEnabled="{Binding IsEnabled, ElementName=ToggleButton}" ToolTip="前进 10 秒"
                            AutomationProperties.Name="前进 10 秒" Click="Forward_Click"/>
                    <Button x:Name="StopButton" Style="{StaticResource TransportButton}" Content="{StaticResource StopIcon}"
                            IsEnabled="{Binding IsEnabled, ElementName=ToggleButton}" ToolTip="停止"
                            AutomationProperties.Name="停止" Click="Stop_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Path Data="M 1,7 H 5 L 10,3 V 17 L 5,13 H 1 Z M 12,6 C 16,7.5 16,12.5 12,14 L 12,12 C 14,11 14,9 12,8 Z M 13,2 C 21,4.5 21,15.5 13,18 L 13,16 C 19,14 19,6 13,4 Z"
                          Fill="{StaticResource PlayerText}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" Value="0.6" Width="100"
                            ToolTip="音量" AutomationProperties.Name="音量" ValueChanged="Volume_Changed"/>
                    <ComboBox x:Name="SpeedBox" SelectedIndex="1" Width="82" Height="40" Padding="9,6" Margin="16,0,0,0"
                              ToolTip="播放速度" AutomationProperties.Name="播放速度" SelectionChanged="Speed_Changed">
                        <ComboBoxItem Content="0.5×" Tag="0.5"/>
                        <ComboBoxItem Content="1.0×" Tag="1"/>
                        <ComboBoxItem Content="1.25×" Tag="1.25"/>
                        <ComboBoxItem Content="1.5×" Tag="1.5"/>
                        <ComboBoxItem Content="2.0×" Tag="2"/>
                    </ComboBox>
                    <Button x:Name="SubtitleButton" Style="{StaticResource TransportButton}" Margin="8,0,0,0"
                            Content="{StaticResource SubtitleIcon}" IsEnabled="{Binding IsEnabled, ElementName=ToggleButton}"
                            ToolTip="选择字幕文件" AutomationProperties.Name="选择字幕文件" Click="ChooseSubtitle_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
